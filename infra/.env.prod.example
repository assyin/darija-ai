# ---------------------------------------------------------------------------
# Production env for the Hetzner all-in-one stack.
# Copy to `.env` next to docker-compose.prod.yml and fill in real values.
# NEVER commit the filled-in .env.
# ---------------------------------------------------------------------------

# --- Domain / images ---
DOMAIN=titritai.com
BACKEND_IMAGE=ghcr.io/YOUR_GH_USER/darija-backend:latest
FRONTEND_IMAGE=ghcr.io/YOUR_GH_USER/darija-frontend:latest

# --- Runtime mode ---
ENVIRONMENT=prod
LOG_LEVEL=INFO

# --- Postgres (compose creates this DB) ---
POSTGRES_USER=darija
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=darija_ai

# --- Backend (pydantic Settings; names match field names) ---
DATABASE_URL=postgresql+asyncpg://darija:CHANGE_ME_STRONG@postgres:5432/darija_ai
REDIS_URL=redis://redis:6379/0
ANTHROPIC_API_KEY=sk-ant-...
REPLICATE_API_TOKEN=r8_...
OPENAI_API_KEY=

# Cloudflare R2 (kept for images)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=darija-ai-images
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Admin auth (single owner). ENVIRONMENT=prod refuses the dev defaults.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG
ADMIN_JWT_SECRET=CHANGE_ME_RANDOM_64_HEX

# CORS — JSON list, your public origin only.
CORS_ORIGINS=["https://titritai.com"]

# Observability (optional)
SENTRY_DSN=

# Public canonical site URL — used by IndexNow on publish to build the
# notification payload. Must match the production domain exactly.
PUBLIC_SITE_URL=https://titritai.com
# IndexNow API key (32-char hex). Generate at https://www.bing.com/indexnow
# or pick any random alphanumeric string 8-128 chars. Must also be served at
# `{PUBLIC_SITE_URL}/{INDEXNOW_API_KEY}.txt` (proof of ownership) —
# frontend/public/<key>.txt handles this.
INDEXNOW_API_KEY=

# --- Frontend (Next.js runtime) ---
# Internal URL for server-side calls (auth provider + /api/admin proxy).
API_BASE_URL=http://backend:8000/api/v1
# NextAuth v5 behind a proxy needs the canonical URL + trusted host.
NEXTAUTH_URL=https://titritai.com
NEXTAUTH_SECRET=CHANGE_ME_RANDOM
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Build-time only (passed as --build-arg in CI, NOT read at runtime):
#   NEXT_PUBLIC_API_BASE_URL=https://titritai.com/api/v1
#   NEXT_PUBLIC_SITE_URL=https://titritai.com
# ---------------------------------------------------------------------------
