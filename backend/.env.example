# Runtime environment: dev | staging | prod
ENVIRONMENT=
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=

# Postgres async DSN (postgresql+asyncpg://user:pass@host:port/dbname)
DATABASE_URL=
DATABASE_POOL_SIZE=
DATABASE_MAX_OVERFLOW=

# Redis DSN (redis://host:port/db)
REDIS_URL=

# Anthropic Claude API key (required)
ANTHROPIC_API_KEY=
# Replicate API token (required)
REPLICATE_API_TOKEN=
# OpenAI API key (optional fallback)
OPENAI_API_KEY=

# Active prompt version pinned in code (e.g. v1, v2)
LOCALIZER_PROMPT_VERSION=

# Cloudflare R2 (object storage for generated images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=darija-ai-images
# S3 endpoint. Match the bucket's jurisdiction:
#   Default:  https://<account_id>.r2.cloudflarestorage.com
#   EU:       https://<account_id>.eu.r2.cloudflarestorage.com
#   FedRAMP:  https://<account_id>.fedramp.r2.cloudflarestorage.com
# Cloudflare's dashboard sometimes lists both Default and EU URLs together; the
# bucket only exists at the endpoint matching its actual jurisdiction.
R2_ENDPOINT_URL=
R2_PUBLIC_URL=

# Sentry DSN (optional; disables Sentry when empty)
SENTRY_DSN=

# Comma-separated list, or JSON array via env. Frontend origins only.
CORS_ORIGINS=["http://localhost:3000"]

# Additional admin logins beyond ADMIN_EMAIL/ADMIN_PASSWORD above, so more than
# one person can sign in to /login. Format: "email1:password1,email2:password2"
# (first colon splits email from password; passwords must not contain ':' or ',').
# Leave empty for a single admin. Keep this OUT of git — set it in the server env.
ADMIN_ACCOUNTS=

# Admin JWT secret (rotate quarterly; min length 10)
ADMIN_JWT_SECRET=
ADMIN_JWT_ALGORITHM=
ADMIN_JWT_EXPIRY_SECONDS=
